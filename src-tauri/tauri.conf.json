{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "FindMyHouse",
  "version": "0.1.0",
  "identifier": "com.findmyhouse.app",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev --workspace frontend",
    "beforeBuildCommand": "npm run build --workspace frontend"
  },
  "app": {
    "windows": [
      {
        "title": "FindMyHouse",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:* http://127.0.0.1:* https://*.amap.com https://*.is.autonavi.com https://*.a-map.com; img-src 'self' https://*.amap.com data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://*.amap.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/backend"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
